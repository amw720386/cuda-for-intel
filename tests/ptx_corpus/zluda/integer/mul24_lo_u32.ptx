.version 6.5
.target sm_30
.address_size 64

.visible .entry mul24_lo_u32(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u32 	    temp;
    .reg .u32 	    temp2;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.u32          temp, [in_addr];
	mul24.lo.u32		temp2, temp, temp;
    st.u32          [out_addr], temp2;
	ret;
}

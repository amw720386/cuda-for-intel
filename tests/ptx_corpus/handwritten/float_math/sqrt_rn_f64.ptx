.version 7.0
.target sm_80
.address_size 64

.visible .entry sqrt_rn_f64(
	.param .u64 out
)
{
	.reg .pred %p<8>;
	.reg .b16 %h<8>;
	.reg .b32 %r<32>;
	.reg .b64 %rd<16>;
	.reg .f32 %f<16>;
	.reg .f64 %fd<8>;
	ld.param.u64 %rd1, [out];
	cvta.to.global.u64 %rd2, %rd1;
	mov.f64 %fd1, 0d3FF0000000000000;
	mov.f64 %fd2, 0d3FF0000000000000;
	mov.u32 %r1, 1;
	mov.u32 %r31, 1;
	sqrt.rn.f64 %fd1, %fd2;
	st.global.u32 [%rd2], %r1;
	ret;
}

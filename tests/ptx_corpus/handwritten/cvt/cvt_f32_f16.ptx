.version 7.0
.target sm_80
.address_size 64

.visible .entry cvt_f32_f16(
	.param .u64 out
)
{
	.reg .pred %p<8>;
	.reg .b16 %h<8>;
	.reg .b32 %r<32>;
	.reg .b64 %rd<16>;
	.reg .f32 %f<16>;
	ld.param.u64 %rd1, [out];
	cvta.to.global.u64 %rd2, %rd1;
	mov.f32 %f1, 0f3F800000;
	ld.global.u16 %h1, [%rd2];
	mov.u32 %r1, 1;
	mov.u32 %r31, 1;
	cvt.f32.f16 %f1, %h1;
	st.global.u32 [%rd2], %r1;
	ret;
}

.version 8.0
.target sm_80
.address_size 64

.visible .entry mma_m8n8k16_s8(
	.param .u64 out
)
{
	.reg .pred %p<8>;
	.reg .b16 %h<8>;
	.reg .b32 %r<32>;
	.reg .b64 %rd<16>;
	.reg .f32 %f<16>;
	ld.param.u64 %rd1, [out];
	cvta.to.global.u64 %rd2, %rd1;
	mov.u32 %r1, 1;
	mov.u32 %r5, 1;
	mov.u32 %r7, 1;
	mov.u32 %r8, 1;
	mov.u32 %r10, 1;
	mov.u32 %r11, 1;
	mov.u32 %r31, 1;
	mma.sync.aligned.m8n8k16.row.col.s32.s8.s8.s32 {%r10,%r11}, {%r1}, {%r5}, {%r7,%r8};
	st.global.u32 [%rd2], %r1;
	ret;
}

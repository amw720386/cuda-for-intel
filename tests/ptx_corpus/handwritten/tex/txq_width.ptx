.version 8.0
.target sm_80
.address_size 64

.visible .entry txq_width(
	.param .u64 out
)
{
	.reg .pred %p<8>;
	.reg .b16 %h<8>;
	.reg .b32 %r<32>;
	.reg .b64 %rd<16>;
	.reg .f32 %f<16>;
	ld.param.u64 %rd1, [out];
	cvta.to.global.u64 %rd2, %rd1;
	mov.u32 %r1, 1;
	mov.u32 %r31, 1;
	mov.u64 %rd3, 1;
	txq.width.b32 %r1, [%rd3];
	st.global.u32 [%rd2], %r1;
	ret;
}

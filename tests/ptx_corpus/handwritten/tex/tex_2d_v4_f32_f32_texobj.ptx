.version 8.0
.target sm_80
.address_size 64

.visible .entry tex_2d_v4_f32_f32_texobj(
	.param .u64 out
)
{
	.reg .pred %p<8>;
	.reg .b16 %h<8>;
	.reg .b32 %r<32>;
	.reg .b64 %rd<16>;
	.reg .f32 %f<16>;
	ld.param.u64 %rd1, [out];
	cvta.to.global.u64 %rd2, %rd1;
	mov.f32 %f1, 0f3F800000;
	mov.f32 %f2, 0f3F800000;
	mov.f32 %f3, 0f3F800000;
	mov.f32 %f4, 0f3F800000;
	mov.f32 %f5, 0f3F800000;
	mov.f32 %f6, 0f3F800000;
	mov.u32 %r1, 1;
	mov.u32 %r31, 1;
	mov.u64 %rd3, 1;
	tex.2d.v4.f32.f32 {%f1,%f2,%f3,%f4}, [%rd3, {%f5,%f6}];
	st.global.u32 [%rd2], %r1;
	ret;
}

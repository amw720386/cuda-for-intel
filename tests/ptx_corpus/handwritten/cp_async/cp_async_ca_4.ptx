.version 8.0
.target sm_80
.address_size 64

.visible .entry cp_async_ca_4(
	.param .u64 out
)
{
	.reg .pred %p<8>;
	.reg .b16 %h<8>;
	.reg .b32 %r<32>;
	.reg .b64 %rd<16>;
	.reg .f32 %f<16>;
	.shared .align 16 .b8 sbuf[1024];
	ld.param.u64 %rd1, [out];
	cvta.to.global.u64 %rd2, %rd1;
	mov.u32 %r2, sbuf;
	mov.u32 %r1, 1;
	mov.u32 %r31, 1;
	cp.async.ca.shared.global [%r2], [%rd2], 4;
	st.global.u32 [%rd2], %r1;
	ret;
}

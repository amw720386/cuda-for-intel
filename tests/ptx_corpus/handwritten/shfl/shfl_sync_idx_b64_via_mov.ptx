.version 8.0
.target sm_80
.address_size 64

.visible .entry shfl_sync_idx_b64_via_mov(
	.param .u64 out
)
{
	.reg .pred %p<8>;
	.reg .b16 %h<8>;
	.reg .b32 %r<32>;
	.reg .b64 %rd<16>;
	.reg .f32 %f<16>;
	ld.param.u64 %rd1, [out];
	cvta.to.global.u64 %rd2, %rd1;
	mov.u32 %r1, 1;
	mov.u32 %r2, 1;
	mov.u32 %r3, 1;
	mov.u32 %r4, 1;
	mov.u32 %r5, 1;
	mov.u32 %r31, 1;
	mov.u64 %rd3, 1;
	mov.u64 %rd4, 1;
	mov.b64 {%r2,%r3}, %rd3;
	shfl.sync.idx.b32 %r4, %r2, 0, 31, 0xffffffff;
	shfl.sync.idx.b32 %r5, %r3, 0, 31, 0xffffffff;
	mov.b64 %rd4, {%r4,%r5};
	st.global.u32 [%rd2], %r1;
	ret;
}

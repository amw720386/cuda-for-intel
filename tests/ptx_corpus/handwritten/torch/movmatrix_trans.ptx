.version 8.0
.target sm_80
.address_size 64
.visible .entry mm(.param .u64 p0)
{
.reg .b32 %r<6>;
.reg .b64 %rd<4>;
ld.param.u64 %rd1, [p0];
cvta.to.global.u64 %rd2, %rd1;
mov.u32 %r1, %tid.x;
shl.b32 %r2, %r1, 16;
or.b32 %r3, %r2, %r1;
movmatrix.sync.aligned.m8n8.trans.b16 %r4, %r3;
mul.wide.u32 %rd3, %r1, 4;
add.s64 %rd3, %rd2, %rd3;
st.global.u32 [%rd3], %r4;
ret;
}

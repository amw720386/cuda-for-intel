.version 8.7
.target sm_120
.address_size 64

.visible .entry bar_red_uniform(
.param .u64 p0
)
.maxntid 256, 1, 1
{
.reg .pred %p<8>;
.reg .b32 %r<12>;
.reg .b64 %rd<6>;

ld.param.u64 %rd1, [p0];
cvta.to.global.u64 %rd2, %rd1;
mov.u32 %r1, %tid.x;
setp.lt.u32 %p3, %r1, 256;
selp.u32 %r2, 1, 0, %p3;
{
.reg .pred %p1;
.reg .pred %p2;
setp.ne.u32 %p1, %r2, 0;
bar.red.or.pred %p2, 0, %p1;
selp.u32 %r3, 1, 0, %p2;
}
setp.eq.s32 %p4, %r3, 0;
@%p4 bra $L_done;
st.global.u32 [%rd2], %r1;
bar.sync 0;
st.global.u32 [%rd2+4], %r1;
$L_done:
ret;
}

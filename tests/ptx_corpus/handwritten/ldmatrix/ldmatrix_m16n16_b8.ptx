.version 8.6
.target sm_100a
.address_size 64

.visible .entry ldmatrix_m16n16_b8(
	.param .u64 out
)
{
	.reg .pred %p<8>;
	.reg .b16 %h<8>;
	.reg .b32 %r<32>;
	.reg .b64 %rd<16>;
	.reg .f32 %f<16>;
	ld.param.u64 %rd1, [out];
	cvta.to.global.u64 %rd2, %rd1;
	mov.u32 %r1, 1;
	mov.u32 %r2, 1;
	mov.u32 %r31, 1;
	ldmatrix.sync.aligned.m16n16.x1.trans.shared.b8 {%r1,%r2}, [%rd2];
	st.global.u32 [%rd2], %r1;
	ret;
}

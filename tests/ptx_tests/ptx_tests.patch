+                failures += 1;
+                let message = payload
+                    .downcast_ref::<String>()
+                    .cloned()
+                    .or_else(|| payload.downcast_ref::<&str>().map(|s| s.to_string()))
+                    .unwrap_or_default();
+                println!("{}: FAIL - Panic: {message}", t.name);
+                continue;
+            }
+        };
         if result.is_err() {
             failures += 1;
         }

+/// `PTX_TESTS_ELEMENTS=<n>` caps the inputs per test (rounded up to a multiple of GROUP_SIZE).
+/// Unset, every test runs 2^32 inputs (all of them for range tests), as upstream does.
+fn sample_elements() -> Option<usize> {
+    let n: usize = std::env::var("PTX_TESTS_ELEMENTS").ok()?.parse().ok()?;
+    Some(next_multiple_of(n.max(GROUP_SIZE), GROUP_SIZE))
+}
+
+/// Input index `i` of a sampled range test with `n` of `total` inputs: the lowest n/8 values,
+/// the highest n/8 values, then uniformly random values.
+fn sampled_value(i: usize, n: usize, total: usize, rng: &mut XorShiftRng) -> u32 {
+    let edge = n / 8;
+    if i < edge {
+        i as u32
+    } else if i < 2 * edge {
+        (total - 1 - (i - edge)) as u32
+    } else {
+        rng.gen_range(0..total as u64) as u32
+    }
+}
 const GROUP_SIZE: usize = 128;
 // Totally unscientific number that works on my machine
 const SAFE_MEMORY_LIMIT: usize = 1 << 29;

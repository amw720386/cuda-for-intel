	mov.f32 %f19, 0f42FE0000;
	div.approx.ftz.f32 %f3, %f18, %f19;
	setp.eq.ftz.f32 %p8, %f18, 0f00000000;
	mov.f32 %f27, 0f00000000;
	@%p8 bra $L_q;
	div.approx.ftz.f32 %f20, %f26, %f3;
	mov.b32 %r35, %f20;

	mov.b32 %f9, %r22;
	max.ftz.f32 %f10, %f8, %f9;
	mov.b32 %r23, %f10;
	mov.u32 %r24, 8;
	shfl.sync.bfly.b32 %r25|%p4, %r23, %r24, %r19, %r21;
	mov.b32 %f11, %r25;
	max.ftz.f32 %f12, %f10, %f11;
	mov.b32 %r26, %f12;
	mov.u32 %r27, 4;
	shfl.sync.bfly.b32 %r28|%p3, %r26, %r27, %r19, %r21;

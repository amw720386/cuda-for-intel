.version 8.8
.target sm_80
.address_size 64

.visible .entry ctaid_probe(
	.param .u64 .ptr ctaid_probe_param_0
)
.maxntid 32
{
	.reg .pred %p<2>;
	.reg .b32 %r<8>;
	.reg .b64 %rd<8>;
	ld.param.u64 %rd1, [ctaid_probe_param_0];
	cvta.to.global.u64 %rd2, %rd1;
	mov.u32 %r1, %tid.x;
	setp.ne.u32 %p1, %r1, 0;
	@%p1 bra $L_done;
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ctaid.y;
	mov.u32 %r4, %ctaid.z;
	mov.u32 %r5, %nctaid.x;
	mov.u32 %r6, %nctaid.y;
	mov.u32 %r7, %nctaid.z;
	st.global.u32 [%rd2], %r2;
	st.global.u32 [%rd2+4], %r3;
	st.global.u32 [%rd2+8], %r4;
	st.global.u32 [%rd2+12], %r5;
	st.global.u32 [%rd2+16], %r6;
	st.global.u32 [%rd2+20], %r7;
$L_done:
	ret;
}

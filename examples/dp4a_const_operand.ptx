// Minimal reproducer of the ggml Q6_K mmvq pattern that fails with native dp4a on Intel:
// dp4a with a constant (folded vsubss4 -32) operand, reused across 4 activation columns.
.version 7.0
.target sm_75
.address_size 64

.visible .entry dp4a_const(
    .param .u64 x_param,
    .param .u64 u_param,
    .param .u64 out_param,
    .param .u32 n_param
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<40>;
    .reg .b64 %rd<20>;

    ld.param.u64 %rd1, [x_param];
    ld.param.u64 %rd2, [u_param];
    ld.param.u64 %rd3, [out_param];
    ld.param.u32 %r1, [n_param];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32 %r2, %tid.x;
    setp.ge.u32 %p1, %r2, %r1;
    @%p1 bra DONE;
    mul.wide.u32 %rd4, %r2, 4;
    add.s64 %rd5, %rd1, %rd4;
    ld.global.u32 %r3, [%rd5];
    and.b32 %r4, %r3, 252645135;
    shl.b32 %r5, %r3, 4;
    and.b32 %r6, %r5, 808464432;
    or.b32 %r7, %r6, %r4;
    mov.u32 %r8, -522133280;
    mov.u32 %r9, 0;
    // column 0
    add.s64 %rd6, %rd2, %rd4;
    ld.global.u32 %r10, [%rd6];
    dp4a.s32.s32 %r11, %r7, %r10, %r9;
    dp4a.s32.s32 %r12, %r8, %r10, %r11;
    add.s64 %rd7, %rd3, %rd4;
    st.global.u32 [%rd7], %r12;
    // column 1
    mul.wide.u32 %rd8, %r1, 4;
    add.s64 %rd9, %rd6, %rd8;
    ld.global.u32 %r13, [%rd9];
    dp4a.s32.s32 %r14, %r7, %r13, %r9;
    dp4a.s32.s32 %r15, %r8, %r13, %r14;
    add.s64 %rd10, %rd7, %rd8;
    st.global.u32 [%rd10], %r15;
    // column 2
    add.s64 %rd11, %rd9, %rd8;
    ld.global.u32 %r16, [%rd11];
    dp4a.s32.s32 %r17, %r7, %r16, %r9;
    dp4a.s32.s32 %r18, %r8, %r16, %r17;
    add.s64 %rd12, %rd10, %rd8;
    st.global.u32 [%rd12], %r18;
    // column 3
    add.s64 %rd13, %rd11, %rd8;
    ld.global.u32 %r19, [%rd13];
    dp4a.s32.s32 %r20, %r7, %r19, %r9;
    dp4a.s32.s32 %r21, %r8, %r19, %r20;
    add.s64 %rd14, %rd12, %rd8;
    st.global.u32 [%rd14], %r21;
DONE:
    ret;
}
